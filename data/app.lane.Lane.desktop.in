[Desktop Entry]
Type=Application
Name=Lane
GenericName=Link Router
Comment=Open links in the right browser, profile, or app
Exec=@LANE_BIN@ %u
TryExec=@LANE_BIN@
Icon=app.lane.Lane
Terminal=false
StartupNotify=true
DBusActivatable=true
Categories=Network;WebBrowser;Qt;KDE;
MimeType=x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/lane;
Keywords=browser;chooser;profile;pwa;opener;
X-KDE-Shortcuts=Ctrl+Alt+O
Actions=Clipboard;

[Desktop Action Clipboard]
Name=Open clipboard URL
Exec=@LANE_BIN@ --clipboard
