<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>lane</string>
    <key>CFBundleName</key>
    <string>Lane</string>
    <key>CFBundleIdentifier</key>
    <string>app.lane.Lane</string>
    <key>CFBundleVersion</key>
    <string>${LANE_VERSION_STRING}</string>
    <key>CFBundleShortVersionString</key>
    <string>${LANE_VERSION_STRING}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- Accessory app: status item only, no Dock icon (owner decision D3). -->
    <key>LSUIElement</key>
    <true/>
    <!-- Icon staged by packaging/mac/bundle.sh into Contents/Resources/Lane.icns. -->
    <key>CFBundleIconFile</key>
    <string>Lane</string>
    <!-- System Settings' default-browser list filters on an app category;
         browsers and router apps all declare one. -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <!-- The default-browser list in System Settings is populated from
         document-type + URL-type handlers; pure CFBundleURLTypes apps
         never appear. OpenIn (also an LSUIElement router) proves the
         pattern: html/url/xhtml content types with a handler rank. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>HTML Document</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.html</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>URL</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.url</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
        </dict>
    </array>

    <!-- http and https only. No mailto/PDF interception. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>http and https link routing</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>http</string>
                <string>https</string>
                <!-- lane://open?url=<encoded> unwraps inside Controller; it is
                     the Shortcuts/Services entry point and never matches a real
                     web scheme, so it cannot claim anything a user clicks. -->
                <string>lane</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <!-- No LSHandlerRank on URL types: every shipping browser or
                 router (OpenIn, Finicky, Browserosaurus) leaves it off and
                 ranks only the document types; ranking the scheme is what
                 kept Lane out of the default-browser list. -->
        </dict>
    </array>
</dict>
</plist>
