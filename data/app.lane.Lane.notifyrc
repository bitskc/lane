[Global]
AppName=Lane
IconName=app.lane.Lane
Comment=Link router

[Event/opened]
Name=Link opened
Comment=Shown when Lane opens a link
Action=Popup

[Event/launch-failed]
Name=Launch failed
Comment=Shown when Lane cannot launch the selected destination
Action=Popup

[Event/save-failed]
Name=Settings not saved
Comment=Shown when Lane cannot write config.json to disk
Action=Popup
