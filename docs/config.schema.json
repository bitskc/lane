{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "https://lane.app/config.schema.json",
    "title": "Lane config",
    "description": "Configuration for ~/.config/lane/config.json",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "version": {
            "type": "integer",
            "default": 1,
            "description": "Schema version"
        },
        "pickerPolicy": {
            "type": "string",
            "enum": [
                "no-rule",
                "always",
                "conflict",
                "never"
            ],
            "default": "no-rule",
            "description": "When to show the picker"
        },
        "closeOnFocusLoss": {
            "type": "boolean",
            "default": true,
            "description": "Close the picker when clicking the dimmed background"
        },
        "showUrl": {
            "type": "boolean",
            "default": true,
            "description": "Show the full URL in the picker"
        },
        "toast": {
            "type": "boolean",
            "default": true,
            "description": "Show a notification after opening"
        },
        "toastMs": {
            "type": "integer",
            "default": 2800,
            "description": "Notification duration in milliseconds"
        },
        "unwrapO365": {
            "type": "boolean",
            "default": true,
            "description": "Unwrap Outlook / Teams safe links so rules see the real destination"
        },
        "unshorten": {
            "type": "boolean",
            "default": true,
            "description": "Expand short URLs via HEAD request"
        },
        "openUnwrapped": {
            "type": "boolean",
            "default": false,
            "description": "Open the unwrapped URL instead of the original wrapper"
        },
        "preferPwa": {
            "type": "boolean",
            "default": true,
            "description": "Open installed web apps automatically when the link belongs to them"
        },
        "holdAutoOpen": {
            "type": "boolean",
            "default": true,
            "description": "Pause before opening remembered, app, and default destinations so you can undo"
        },
        "holdMs": {
            "type": "integer",
            "default": 1600,
            "minimum": 400,
            "description": "Hold duration in milliseconds before a silent open launches"
        },
        "autostart": {
            "type": "boolean",
            "default": false,
            "description": "Start Lane when you log in"
        },
        "defaultTargetId": {
            "type": "string",
            "default": "",
            "description": "Target to use when no rule, memory, or PWA matches and the picker is disabled"
        },
        "hiddenTargetIds": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Target IDs hidden from the picker"
        },
        "recentTargetIds": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Recently used target IDs, most recent first"
        },
        "remembered": {
            "type": "object",
            "description": "Destination key to target ID. Keys are host or host/path (e.g. github.com/bitskc).",
            "additionalProperties": {
                "type": "string"
            }
        },
        "rules": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "pattern",
                    "scope",
                    "targetId"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "pattern": {
                        "type": "string"
                    },
                    "scope": {
                        "type": "string",
                        "enum": [
                            "domain",
                            "path",
                            "any"
                        ]
                    },
                    "location": {
                        "type": "string",
                        "enum": [
                            "url",
                            "title",
                            "process"
                        ],
                        "default": "url"
                    },
                    "regex": {
                        "type": "boolean",
                        "default": false
                    },
                    "targetId": {
                        "type": "string"
                    },
                    "enabled": {
                        "type": "boolean",
                        "default": true
                    }
                }
            }
        },
        "customTargets": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name",
                    "exec"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "exec": {
                        "type": "string"
                    },
                    "args": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "icon": {
                        "type": "string"
                    },
                    "browserName": {
                        "type": "string",
                        "description": "Optional label used in subtitles. Written on save; loaded from the file but only affects display text."
                    },
                    "kind": {
                        "type": "string",
                        "enum": [
                            "app",
                            "action",
                            "browser",
                            "pwa",
                            "container"
                        ],
                        "description": "Written when the settings UI saves config but ignored on load; every custom target loads as a custom app."
                    }
                }
            }
        },
        "substitutions": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "find",
                    "replace"
                ],
                "properties": {
                    "find": {
                        "type": "string"
                    },
                    "replace": {
                        "type": "string"
                    },
                    "regex": {
                        "type": "boolean",
                        "default": false
                    }
                }
            }
        },
        "targetOrder": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Target IDs in display order. Empty or missing means discovery order."
        },
        "targetAliases": {
            "type": "object",
            "description": "Target ID to custom display name. Empty value means use the discovered name.",
            "additionalProperties": {
                "type": "string"
            }
        }
    }
}
