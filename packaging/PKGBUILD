pkgname=lane
pkgver=0.3.0
pkgrel=1
pkgdesc="Plasma-native link router: open the right browser, profile, or app"
arch=('x86_64')
url="https://github.com/bitskc/lane"
license=('custom:PolyForm-Noncommercial-1.0.0')
depends=(
  qt6-base qt6-declarative qt6-svg
  layer-shell-qt
)
makedepends=(cmake extra-cmake-modules ninja appstream kwindowsystem)
optdepends=('kwindowsystem: xdg-activation token handoff when launching a browser on Wayland')
source=("$pkgname-$pkgver.tar.gz::https://github.com/bitskc/lane/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('549ab49a69cf6dca4e9ac075e773f3b84c6bbd832875f23fa2b474e03558299a')

build() {
  cmake -S "$srcdir/$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  cmake --install build --prefix build/throwaway-install
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
